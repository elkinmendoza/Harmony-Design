{
  "$description": "Harmony component tokens — component-scoped aliases. These reference SEMANTIC tokens only (color.*, space.*, radius.*, shadow.*, text.*, heading.*), never primitives. Emitted as CSS custom properties --{component}-{property}. Themes/verticals override semantic tokens; components rarely need overriding directly. Derived from the EM Mendoza portfolio (2026-ultimate-portfolio).",
  "$conventions": {
    "cssPattern": "--{component}-{property}",
    "aliasTarget": "semantic",
    "example": "button.primary.bg -> color.background.brand -> --button-primary-bg"
  },

  "button": {
    "primary": {
      "bg":       "color.background.brand",
      "bgHover":  "color.content.brand",
      "fg":       "color.content.onBrand",
      "border":   "color.border.brand",
      "radius":   "radius.md",
      "paddingX": "space.lg",
      "paddingY": "space.sm",
      "font":     "text.sm"
    },
    "secondary": {
      "bg":       "color.background.secondary",
      "bgHover":  "color.background.tertiary",
      "fg":       "color.content.primary",
      "border":   "color.border.default",
      "radius":   "radius.md",
      "paddingX": "space.lg",
      "paddingY": "space.sm",
      "font":     "text.sm"
    },
    "ghost": {
      "bg":       "transparent",
      "bgHover":  "color.background.secondary",
      "fg":       "color.content.primary",
      "border":   "transparent",
      "radius":   "radius.md",
      "paddingX": "space.md",
      "paddingY": "space.sm",
      "font":     "text.sm"
    }
  },

  "input": {
    "bg":            "color.background.primary",
    "fg":            "color.content.primary",
    "placeholder":   "color.content.tertiary",
    "border":        "color.border.default",
    "borderFocus":   "color.border.brand",
    "borderError":   "color.status.negative",
    "radius":        "radius.md",
    "paddingX":      "space.md",
    "paddingY":      "space.sm",
    "font":          "text.md"
  },

  "card": {
    "bg":       "color.background.primary",
    "border":   "color.border.subtle",
    "fg":       "color.content.primary",
    "radius":   "radius.lg",
    "padding":  "space.xl",
    "shadow":   "shadow.card"
  },

  "badge": {
    "bg":       "color.background.brand",
    "fg":       "color.content.onBrand",
    "radius":   "radius.full",
    "paddingX": "space.sm",
    "paddingY": "space.xs",
    "font":     "text.xs"
  },

  "header": {
    "$description": "Desktop navigation header — fixed top, scroll hide/show, logo + bio + nav links.",
    "bg":           "color.background.primary",
    "fg":           "color.content.primary",
    "fgHover":      "color.content.secondary",
    "border":       "color.border.subtle",
    "paddingX":     "space.lg",
    "paddingY":     "space.sm",
    "maxWidth":     "1440px",
    "fontNav":      "text.md",
    "fontBio":      "text.xs",
    "fontFamily":   "font.family.sans",
    "zIndex":       50,
    "logoWidth":    "189px",
    "logoHeight":   "25px"
  },

  "mobileNav": {
    "$description": "Mobile navigation with fullscreen overlay menu — hamburger trigger, fullscreen dark overlay with large nav links.",
    "bg":              "color.background.primary",
    "bgOverlay":       "color.background.inverse",
    "fg":              "color.content.primary",
    "fgOverlay":       "color.content.inverse",
    "fgSecondary":     "color.content.secondary",
    "ctaBg":           "color.background.primary",
    "ctaFg":           "color.content.primary",
    "ctaRadius":       "radius.lg",
    "paddingX":        "space.lg",
    "paddingY":        "space.sm",
    "paddingXOverlay": "space.xl",
    "paddingYOverlay": "space.md",
    "fontNav":         "heading.xl",
    "fontLabel":       "text.md",
    "fontLogo":        "heading.xs",
    "fontCaption":     "text.xs",
    "zIndex":          50,
    "zIndexOverlay":   60
