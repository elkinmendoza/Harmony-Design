  "heroBanner": {
    "$description": "Full-viewport hero with oversized typographic headline (Clash Grotesk Bold) and embedded inline images. Signature portfolio entrance.",
    "fg":               "color.content.primary",
    "fontDisplay":      "heading.9xl",
    "fontTagline":      "text.md",
    "fontTaglineFamily":"font.family.sans",
    "fontDisplayFamily":"font.family.display",
    "paddingX":         "space.lg",
    "paddingBottom":    "space.4xl",
    "gapLines":         "space.sm",
    "gapWords":         "space.xs",
    "imageWidth": {
      "sm":  "90px",
      "md":  "120px",
      "lg":  "180px",
      "xl":  "248px",
      "2xl": "328px"
    },
    "imageHeight": {
      "sm":  "44px",
      "md":  "60px",
      "lg":  "80px",
      "xl":  "115px"
    },
    "animation": {
      "type": "gsap",
      "from": { "y": 50, "opacity": 0 },
      "to":   { "y": 0, "opacity": 1 },
      "duration": "1s",
      "stagger": "0.2s",
      "ease": "power3.out"
