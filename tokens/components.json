    "fontHeadline":    "heading.xs",
    "fontTitle":       "heading.xs",
    "fontDescription": "heading.xs",
    "headlineFamily":  "font.family.sans",
    "titleFamily":     "font.family.sans",
    "descFamily":      "font.family.sans",
    "paddingX":        "space.lg",
    "paddingY":        "space.4xl",
    "maxWidth":        "1440px",
    "leftWidth":       "342px",
    "gapValues":       "space.2xl",
    "gapItems":        "space.sm",
    "itemPadding":     "space.2xl"
  },

  "pageTransition": {
    "$description": "Page transition with curtain wipe effect — dark curtain rises then wipes away, content fades in.",
    "curtainBg":       "color.background.inverse",
    "zIndex":          100,
    "animation": {
      "type": "gsap",
      "curtainRise":  { "duration": "0.7s", "ease": "expo.inOut" },
      "curtainWipe":  { "duration": "0.9s", "ease": "expo.inOut" },
      "contentFade":  { "duration": "0.5s", "ease": "power2.out" }
    }
  },

  "preloader": {
    "$description": "Initial load preloader with logo mask fill animation and percentage counter.",
    "bg":            "color.background.inverse",
    "fgLogo":        "color.content.inverse",
    "fgLogoBase":    "color.content.tertiary",
    "fgCounter":     "color.content.inverse",
    "zIndex":        9999,
    "fontCounter":   "text.sm",
    "counterFamily": "font.family.sans",
    "paddingX":      "space.lg",
    "counterBottom": "space.xl",
    "animation": {
      "type": "gsap",
      "fillDuration": "3.2s",
      "fadeOutDuration": "0.85s",
      "panelWipeDuration": "1s"
    }
  },

  "smoothScroller": {
    "$description": "Lenis-powered smooth scrolling utility with GSAP sync. Not a visual component.",
    "lerp": 0.1,
    "duration": 1.2,
    "touchMultiplier": 2,
    "gestureOrientation": "vertical",
    "anchorOffset": -80,
    "respectsReducedMotion": true
  }
}
